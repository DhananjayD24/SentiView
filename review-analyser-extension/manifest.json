{
  "manifest_version": 3,
  "name": "Product Review Analyzer",
  "version": "1.0",
  "description": "Extracts product reviews and sends them for analysis",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.amazon.in/*",
    "https://www.flipkart.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  
  "content_scripts": [
  {
    "matches": ["<all_urls>"],
    "js": ["content.js"]
  }
]
}
